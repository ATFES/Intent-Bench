#include <bang.h>
#include <cnrt.h>
__mlu_global__ void traffic(float *x,float *y,int n,int step,int mode,int trips){
    __nram__ float local[2048];
    if(mode==0)return;
    if(mode==4){
        __memcpy(local,x+taskId*2048,8192,GDRAM2NRAM);
        for(int k=0;k<trips;k++) __bang_mul_scalar(local,local,1.00001f,2048);
        __memcpy(y+taskId*2048,local,8192,NRAM2GDRAM);return;
    }
    if(mode==2)__bang_write_value(local,2048,1.f);
    for(int k=0;k<trips;k++){
        long offset=((long)k*taskDim+taskId)*n*step;
        if(mode==3){__sync_io();continue;}
        if(mode==1){
            if(step==1)__memcpy(local,x+offset,n*4,GDRAM2NRAM);
            else __memcpy(local,x+offset,4,GDRAM2NRAM,4,step*4,n-1);
            y[k*taskDim+taskId]=local[n-1];
        }else{
            if(step==1)__memcpy(y+offset,local,n*4,NRAM2GDRAM);
            else __memcpy(y+offset,local,4,NRAM2GDRAM,step*4,4,n-1);
        }
    }
}
extern "C" int enqueue(float*x,float*y,int n,int step,int mode,int trips,void*queue){
    cnrtDim3_t dim={16,1,1};
    traffic<<<dim,cnrtFuncTypeBlock,(cnrtQueue_t)queue>>>(x,y,n,step,mode,trips);
    return cnrtGetLastError();
}
