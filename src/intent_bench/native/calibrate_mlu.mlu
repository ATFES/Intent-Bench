#include <bang.h>
#include <cnrt.h>
#ifdef PROFILE_CERTIFIED_DIV
#include "certified_div.mlu"
#endif
#ifdef PROFILE_GUARDED_DIV
#include "guarded_reciprocal.mlu"
#endif
__mlu_global__ void traffic(float *x,float *y,int n,int step,int mode,int trips){
    __nram__ float local[2048];
    if(mode==0)return;
    if(mode>=10 && mode<=12){
        __nram__ float tmp[2048];
        if(mode==11||mode==12) __memcpy(local,x+taskId*n,n*4,GDRAM2NRAM);
        for(int k=0;k<trips;k++){
            long offset=((long)k*taskDim+taskId)*n;
            if(mode==10){
                __memcpy(local,x+offset,n*4,GDRAM2NRAM);
                __bang_mul_scalar(tmp,local,1.00001f,n);
            }else if(mode==11){
                __bang_mul_scalar(tmp,local,1.00001f,n);
                __memcpy(y+offset,tmp,n*4,NRAM2GDRAM);
            }else{
                __bang_mul_scalar(tmp,local,1.00001f,n);
            }
            asm volatile("" ::: "memory");
        }
        if(mode==10||mode==12) __memcpy(y+taskId*n,tmp,n*4,NRAM2GDRAM);
        return;
    }
    if(mode>=6){
        __nram__ float tmp[2048];
        __nram__ float divisor[2048];
        if(mode==9 || mode==15 || mode==18) __bang_write_value(divisor,n,1.75f);
        __memcpy(local,x+taskId*n,n*4,GDRAM2NRAM);
        for(int k=0;k<trips;k++) {
            if(mode==6) { __bang_argmax(tmp,local,n); __sync_compute(); }
            if(mode==7) { __bang_sumpool(tmp,local,32,n/32,1,n/32,1,1,1); __bang_reduce_sum(tmp,tmp,32); __sync_compute(); }
            if(mode==8) { __bang_abs(tmp,local,n);__bang_argmax(tmp,tmp,n);__sync_compute();__bang_active_exphp(tmp,local,n); }
            if(mode==9) __cn_vector_div_f32_rn(n,tmp,local,divisor);
            if(mode==13) __cn_vector_div_scalar_f32_rn(n,tmp,local,1.75f);
            if(mode==14) __cn_scalar_div_vector_f32_rn(n,tmp,1.75f,local);
#ifdef PROFILE_CERTIFIED_DIV
            __nram__ float scratch[6 * 2048];
            if(mode==15) certified_div_rn(tmp,local,divisor,scratch,n,n);
            if(mode==16) certified_div_rn(tmp,local,1.75f,scratch,n,n);
            if(mode==17) certified_div_rn(tmp,1.75f,local,scratch,n,n);
#endif
#ifdef PROFILE_GUARDED_DIV
            if(mode==18) guarded_reciprocal_product(tmp,local,divisor,scratch,n,n);
            if(mode==19) guarded_reciprocal_product(tmp,local,1.75f,scratch,n,n);
            if(mode==20) guarded_reciprocal_product(tmp,1.75f,local,scratch,n,n);
#endif
            asm volatile("" ::: "memory");
        }
        __memcpy(y+taskId*n,tmp,n*4,NRAM2GDRAM);
        return;
    }
    if(mode==5){
        __memcpy_async(local,x+taskId*n,n*4,GDRAM2NRAM);
        __sync();
        __memcpy(y+taskId*n,local,n*4,NRAM2GDRAM);
        return;
    }
    if(mode==4){
        __memcpy(local,x+taskId*2048,8192,GDRAM2NRAM);
        for(int k=0;k<trips;k++) __bang_mul_scalar(local,local,1.00001f,2048);
        __memcpy(y+taskId*2048,local,8192,NRAM2GDRAM);return;
    }
    if(mode==2)__bang_write_value(local,2048,1.f);
    for(int k=0;k<trips;k++){
        long offset=((long)k*taskDim+taskId)*n*step;
        if(mode==3){__sync_io();continue;}
        if(mode==1){
            if(step==1)__memcpy(local,x+offset,n*4,GDRAM2NRAM);
            else __memcpy(local,x+offset,4,GDRAM2NRAM,4,step*4,n-1);
            asm volatile("" ::: "memory");
        }else{
            if(step==1)__memcpy(y+offset,local,n*4,NRAM2GDRAM);
            else __memcpy(y+offset,local,4,NRAM2GDRAM,step*4,4,n-1);
        }
    }
}
extern "C" int enqueue_tasks(float*x,float*y,int n,int step,int mode,int trips,int tasks,void*queue){
    cnrtDim3_t dim={(unsigned)tasks,1,1};
    traffic<<<dim,cnrtFuncTypeBlock,(cnrtQueue_t)queue>>>(x,y,n,step,mode,trips);
    return cnrtGetLastError();
}
extern "C" int enqueue(float*x,float*y,int n,int step,int mode,int trips,void*queue){
    return enqueue_tasks(x,y,n,step,mode,trips,16,queue);
}
